# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local auth testing
# Development defaults to mock auth so Supabase OAuth redirect allowlists do not block localhost testing.
# Set to false when you want to test real OAuth locally.
NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH=true

# Analytics (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Admin
ADMIN_EMAILS=your-email@gmail.com
